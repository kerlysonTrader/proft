# Copie para .env SOMENTE para desenvolvimento local. Nunca faça commit do .env.
# Na VM os segredos vêm do Google Secret Manager: basta definir GCP_PROJECT.
#
# GCP_PROJECT=bybit-scanner-bot
#
# Sem GCP_PROJECT, os segredos são lidos destas variáveis:
BYBIT_API_KEY=
BYBIT_API_SECRET=
BOT_INGEST_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
COINVERSA_API_KEY=

# Modo live exige config explícita E esta variável:
# CONFIRM_LIVE=SIM
